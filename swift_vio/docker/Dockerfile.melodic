# ============================================================================
# swift_vio / KSWF —— ROS1 Melodic (Ubuntu 18.04) 构建镜像
#
# swift_vio 仅支持 ROS1 (kinetic/melodic)；核心库可 -DUSE_ROS=OFF，但离线入口
# swift_vio_node_synchronous（同步读 rosbag）依赖 ROS，故此处用完整 melodic。
#
# 源码不从网络 clone（原仓 404）：构建上下文里的 bundle 由 restore_swift_vio.sh
# 还原到 ws/src，再 COPY 进镜像后 catkin build。因此：
#   构建前先在宿主机跑：   ./restore_swift_vio.sh docker/ws/src
#   构建上下文 = swift_vio/（含 docker/ 与 ws/），见 docker/build.sh。
# gtsam 为可选依赖（SlidingWindowSmoother 才需要）；本标定用 HybridFilter，默认不装
# 以缩短构建，需要平滑器时把 WITH_GTSAM=ON 打开。
# ============================================================================
FROM ros:melodic-perception-bionic

ENV DEBIAN_FRONTEND=noninteractive ROS_VERSION=melodic
SHELL ["/bin/bash", "-c"]

# --- 系统依赖（README §Build dependencies） ---------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git wget unzip \
      libgoogle-glog-dev libgflags-dev \
      libatlas-base-dev libeigen3-dev libsuitesparse-dev \
      libboost-dev libboost-filesystem-dev libboost-system-dev \
      libopencv-dev \
      python-catkin-tools python-rosdep \
      ros-melodic-cv-bridge ros-melodic-image-transport \
      ros-melodic-pcl-ros ros-melodic-tf ros-melodic-rosbag \
      ros-melodic-gps-common \
    && rm -rf /var/lib/apt/lists/*

# --- Ceres 1.14（swift_vio 要求 Ceres 14 + Eigen>=3.3；Ubuntu18 系统 Eigen 3.3.4 满足） ---
RUN mkdir -p /opt/src && cd /opt/src \
    && wget -q http://ceres-solver.org/ceres-solver-1.14.0.tar.gz \
    && tar zxf ceres-solver-1.14.0.tar.gz \
    && mkdir ceres-bin && cd ceres-bin \
    && cmake ../ceres-solver-1.14.0 -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_EXAMPLES=OFF \
    && make -j"$(nproc)" && make install \
    && cd / && rm -rf /opt/src/ceres-solver-1.14.0.tar.gz

# --- gtsam（可选） ----------------------------------------------------------
ARG WITH_GTSAM=OFF
RUN if [ "$WITH_GTSAM" = "ON" ]; then \
      apt-get update && apt-get install -y --no-install-recommends libtbb-dev && rm -rf /var/lib/apt/lists/* ; \
      cd /opt/src && git clone https://github.com/borglab/gtsam.git --recursive \
      && cd gtsam && git checkout 6c85850147751d45cf9c595f1a7e623d239305fc \
      && mkdir build && cd build \
      && cmake -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_BUILD_TYPE=Release \
         -DGTSAM_TANGENT_PREINTEGRATION=OFF -DGTSAM_POSE3_EXPMAP=ON -DGTSAM_ROT3_EXPMAP=ON \
         -DGTSAM_USE_SYSTEM_EIGEN=ON -DGTSAM_BUILD_TESTS=OFF -DGTSAM_BUILD_EXAMPLES_ALWAYS=OFF .. \
      && make -j"$(nproc)" install ; \
    fi

# --- 拷入已还原源码（宿主机先跑 restore_swift_vio.sh docker/ws/src） --------
WORKDIR /swift_vio_ws
COPY ws/src /swift_vio_ws/src

# --- catkin 构建 ------------------------------------------------------------
ARG GTSAM_ARGS=""
RUN source /opt/ros/${ROS_VERSION}/setup.bash \
    && catkin init \
    && catkin config --merge-devel \
    && catkin config --extend /opt/ros/${ROS_VERSION} \
    && catkin build vio_common swift_vio \
         --cmake-args -DUSE_ROS=ON -DBUILD_TESTS=OFF -DCMAKE_BUILD_TYPE=Release ${GTSAM_ARGS} \
    && echo "source /swift_vio_ws/devel/setup.bash" >> /root/.bashrc

# 运行入口：交互 bash（离线标定命令见 run_swift_vio.sh / README §3）
CMD ["bash"]
